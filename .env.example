# Apni Dukaan — Phase 2 environment (variable NAMES only; real secrets live
# in the server secret store / Secure Vault, never in source control).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/canteen_pos
# COOKIE_SECURE=1          # set when served over HTTPS
# BACKUP_DIR=/path/to/backups
# Public ordering origin used on printed table-QR cards (deployment step):
# PUBLIC_ORDER_BASE_URL=https://order.example.com
# ── Account verification code delivery (deployment step) ──────────────────
# Email confirmation codes (MANDATORY for new customer accounts) go out
# over SMTP. Jab tak ye set na hon, system honestly "NOT_CONFIGURED"
# batata hai — koi code bheja hua NAHI kaha jata.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Apni Dukaan <no-reply@example.com>
# Mobile confirmation codes (OPTIONAL) go through an SMS provider's HTTP
# API (POST JSON {to, message, apiKey} + Bearer auth).
# SMS_API_URL=https://sms-provider.example/api/send
# SMS_API_KEY=
